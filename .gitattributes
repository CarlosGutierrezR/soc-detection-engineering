# Normalize text files in the repository
* text=auto

# Documentation and configuration
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Repository metadata
.gitignore text eol=lf
.gitattributes text eol=lf

# GitHub language statistics: the Wazuh rule (XML) is the main artifact;
# the regex test helper is not counted
detection-rules/*.xml linguist-detectable=true
tests/*.sh linguist-detectable=false
